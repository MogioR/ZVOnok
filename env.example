# Copy this file to `.env` and fill in real values before running:
# cp env.example .env

# Port the Go server listens on inside the container
PORT=8080

# Port exposed on the host machine
HOST_PORT=8080

# Directory with compiled frontend files
STATIC_DIR=./static

# Timezone for logs
TZ=Europe/Moscow

# TURN server network configuration
TURN_PUBLIC_IP=your.public.ip
TURN_PRIVATE_IP=your.private.ip

# TURN credentials
TURN_USER=zvonok
TURN_PASS=change-me-to-a-strong-secret
